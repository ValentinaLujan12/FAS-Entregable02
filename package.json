{
  "name": "el-apuntado",
  "version": "2.0.0",
  "description": "El Apuntado: juego de cartas multijugador en linea (Vercel + Supabase), servidor autoritativo con reglas Strategy",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx src/serverless/dev.ts",
    "build": "esbuild src/web/main.ts --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=public/app.js",
    "build:dev": "esbuild src/web/main.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx tools/e2e-http.ts",
    "test:ui": "node tools/e2e-ui.mjs",
    "bpmn:generate": "node tools/bpmn/generar.mjs",
    "bpmn:validate": "node tools/validate-bpmn.mjs",
    "bpmn:sim": "node tools/build-bpmn-sim.mjs",
    "bpmn:render": "node tools/render-bpmn.mjs",
    "bpmn:all": "npm run bpmn:generate && npm run bpmn:validate && npm run bpmn:sim",
    "uml:render": "node tools/render-uml.mjs",
    "assets:generate": "tsx tools/generate-assets.ts",
    "capturas": "node tools/capturas.mjs",
    "test:cov": "vitest run --coverage",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "cc": "eslint src api",
    "verify": "npm run typecheck && npm run deps && npm run deps:sondas && npm run cc && npm run aserciones && npm run metricas && npm run test:cov",
    "cc:ui": "eslint --config eslint.ui.config.js src/web src/extras",
    "deps:sondas": "node tools/sondas-dependencias.mjs",
    "aserciones": "node tools/verificar-aserciones.mjs",
    "metricas": "node tools/metricas-modulos.mjs",
    "latencia": "tsx tools/medir-latencia.ts",
    "gobernanza:reporte": "node tools/reporte-gobernanza.mjs",
    "auditoria:reglas": "tsx tools/auditoria-reglas.ts",
    "simular:bots": "tsx tools/simular-bots.ts",
    "ff32": "tsx tools/ff32-latencia-produccion.ts"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.119.0",
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "@vitest/coverage-v8": "^5.1.1",
    "bpmn-js": "^17.11.0",
    "bpmn-js-token-simulation": "^0.36.0",
    "bpmn-moddle": "^9.0.1",
    "dependency-cruiser": "^18.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "opentype.js": "^1.3.4",
    "playwright-core": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
