<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Colaboracion" name="05 - Colaboración cliente &lt;-&gt; servidor &lt;-&gt; Supabase (HTTP con buzones)" targetNamespace="http://apuntado.unal.edu.co/bpmn" exporter="el-apuntado generador" exporterVersion="1.0">
<bpmn:collaboration id="Colaboracion_Colaboracion"><bpmn:participant id="Pool_Cliente" name="Jugador (cliente web)" processRef="Proceso_Pool_Cliente" /><bpmn:participant id="Pool_Servidor" name="Servidor de juego (TurnOrchestrator - PartidaEnCurso)" processRef="Proceso_Pool_Servidor" /><bpmn:participant id="Pool_Base" name="Supabase (IAlmacen)" processRef="Proceso_Pool_Base" /><bpmn:messageFlow id="Mensaje_1" sourceRef="j_crear" targetRef="s_ini" name="crear_sala" /><bpmn:messageFlow id="Mensaje_2" sourceRef="s_guardar1" targetRef="d_ini" name="guardar" /><bpmn:messageFlow id="Mensaje_3" sourceRef="s_sesion" targetRef="j_sesion" name="sesion + estado" /><bpmn:messageFlow id="Mensaje_4" sourceRef="j_iniciar" targetRef="s_espera1" name="iniciar" /><bpmn:messageFlow id="Mensaje_5" sourceRef="s_guardar2" targetRef="d_r2" name="guardar" /><bpmn:messageFlow id="Mensaje_6" sourceRef="s_difundir" targetRef="j_ronda" name="estado" /><bpmn:messageFlow id="Mensaje_7" sourceRef="s_turno" targetRef="j_turno" name="estado" /><bpmn:messageFlow id="Mensaje_8" sourceRef="j_robar" targetRef="s_esp_robar" name="robar" /><bpmn:messageFlow id="Mensaje_9" sourceRef="s_robo" targetRef="j_robo" name="estado" /><bpmn:messageFlow id="Mensaje_10" sourceRef="j_desc" targetRef="s_r_desc" name="descartar" /><bpmn:messageFlow id="Mensaje_11" sourceRef="j_cerrar" targetRef="s_r_cerrar" name="cerrar" /><bpmn:messageFlow id="Mensaje_12" sourceRef="s_dep" targetRef="d_r3" name="guardar" /><bpmn:messageFlow id="Mensaje_13" sourceRef="s_cierre" targetRef="d_r3" name="guardar" /><bpmn:messageFlow id="Mensaje_14" sourceRef="s_dif1" targetRef="j_sig" name="estado" /><bpmn:messageFlow id="Mensaje_15" sourceRef="s_dif2" targetRef="j_liq" name="eventos + estado" /></bpmn:collaboration>
<bpmn:process id="Proceso_Pool_Cliente" name="Jugador (cliente web)" isExecutable="false"><bpmn:startEvent id="j_inicio" name="Abre la app"><bpmn:outgoing>Flujo_Pool_Cliente_1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="j_crear" name="crear_sala(nombre, modalidad)"><bpmn:documentation>MensajeCliente {t:&quot;crear_sala&quot;}</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cliente_1</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_2</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="j_sesion" name="sesion + estado (ESPERA)" instantiate="false"><bpmn:incoming>Flujo_Pool_Cliente_2</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_3</bpmn:outgoing></bpmn:receiveTask><bpmn:sendTask id="j_iniciar" name="agregar_bot / iniciar"><bpmn:incoming>Flujo_Pool_Cliente_3</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_4</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="j_ronda" name="estado EN_CURSO + mano privada" instantiate="false"><bpmn:incoming>Flujo_Pool_Cliente_4</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_5</bpmn:outgoing></bpmn:receiveTask><bpmn:receiveTask id="j_turno" name="estado: turno propio (fase ROBAR)" instantiate="false"><bpmn:incoming>Flujo_Pool_Cliente_5</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_6</bpmn:outgoing></bpmn:receiveTask><bpmn:sendTask id="j_robar" name="robar(MAZO | POZO)"><bpmn:incoming>Flujo_Pool_Cliente_6</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_7</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="j_robo" name="estado: fase DESCARTAR + carta robada" instantiate="false"><bpmn:incoming>Flujo_Pool_Cliente_7</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_8</bpmn:outgoing></bpmn:receiveTask><bpmn:exclusiveGateway id="j_g" name="¿Cierra la ronda?"><bpmn:incoming>Flujo_Pool_Cliente_8</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_9</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Cliente_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="j_desc" name="descartar(cartaId)"><bpmn:incoming>Flujo_Pool_Cliente_9</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_11</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="j_cerrar" name="cerrar()"><bpmn:incoming>Flujo_Pool_Cliente_10</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_12</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="j_sig" name="estado: turno del siguiente jugador" instantiate="false"><bpmn:incoming>Flujo_Pool_Cliente_11</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_13</bpmn:outgoing></bpmn:receiveTask><bpmn:receiveTask id="j_liq" name="eventos + estado: liquidación" instantiate="false"><bpmn:incoming>Flujo_Pool_Cliente_12</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cliente_14</bpmn:outgoing></bpmn:receiveTask><bpmn:endEvent id="j_f1" name="Turno completado"><bpmn:incoming>Flujo_Pool_Cliente_13</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="j_f2" name="Ronda liquidada"><bpmn:incoming>Flujo_Pool_Cliente_14</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_Cliente_1" sourceRef="j_inicio" targetRef="j_crear"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_2" sourceRef="j_crear" targetRef="j_sesion"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_3" sourceRef="j_sesion" targetRef="j_iniciar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_4" sourceRef="j_iniciar" targetRef="j_ronda"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_5" sourceRef="j_ronda" targetRef="j_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_6" sourceRef="j_turno" targetRef="j_robar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_7" sourceRef="j_robar" targetRef="j_robo"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_8" sourceRef="j_robo" targetRef="j_g"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_9" sourceRef="j_g" targetRef="j_desc" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_10" sourceRef="j_g" targetRef="j_cerrar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_11" sourceRef="j_desc" targetRef="j_sig"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_12" sourceRef="j_cerrar" targetRef="j_liq"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_13" sourceRef="j_sig" targetRef="j_f1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cliente_14" sourceRef="j_liq" targetRef="j_f2"></bpmn:sequenceFlow></bpmn:process>
<bpmn:process id="Proceso_Pool_Servidor" name="Servidor de juego (TurnOrchestrator - PartidaEnCurso)" isExecutable="false"><bpmn:startEvent id="s_ini" name="crear_sala"><bpmn:outgoing>Flujo_Pool_Servidor_15</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent><bpmn:serviceTask id="s_crear" name="Crear la sala y el código único"><bpmn:documentation>Componente: LobbyManager</bpmn:documentation><bpmn:incoming>Flujo_Pool_Servidor_15</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_16</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="s_guardar1" name="Persistir la sala"><bpmn:documentation>Componente: StateRepository</bpmn:documentation><bpmn:incoming>Flujo_Pool_Servidor_16</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_17</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="s_sesion" name="Enviar sesion + estado"><bpmn:incoming>Flujo_Pool_Servidor_17</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_18</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="s_espera1" name="Esperar agregar_bot / iniciar" instantiate="false"><bpmn:incoming>Flujo_Pool_Servidor_18</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_19</bpmn:outgoing></bpmn:receiveTask><bpmn:serviceTask id="s_repartir" name="Validar 2-6 jugadores, barajar y repartir"><bpmn:documentation>Componente: DeckManagement</bpmn:documentation><bpmn:incoming>Flujo_Pool_Servidor_19</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_20</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="s_guardar2" name="Persistir el estado inicial"><bpmn:incoming>Flujo_Pool_Servidor_20</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_21</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="s_difundir" name="Difundir estado (la mano solo a su dueño)"><bpmn:incoming>Flujo_Pool_Servidor_21</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_22</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="s_turno" name="Iniciar turno: cronómetro + estado &quot;tu turno&quot;"><bpmn:incoming>Flujo_Pool_Servidor_22</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_23</bpmn:outgoing></bpmn:sendTask><bpmn:receiveTask id="s_esp_robar" name="Esperar robar" instantiate="false"><bpmn:incoming>Flujo_Pool_Servidor_23</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_24</bpmn:outgoing></bpmn:receiveTask><bpmn:serviceTask id="s_robar" name="Validar el turno y robar (mazo o pozo)"><bpmn:documentation>Componente: DeckManagement</bpmn:documentation><bpmn:incoming>Flujo_Pool_Servidor_24</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_25</bpmn:outgoing></bpmn:serviceTask><bpmn:sendTask id="s_robo" name="Difundir estado (carta robada privada)"><bpmn:incoming>Flujo_Pool_Servidor_25</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_26</bpmn:outgoing></bpmn:sendTask><bpmn:eventBasedGateway id="s_ev"><bpmn:incoming>Flujo_Pool_Servidor_26</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_27</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Servidor_28</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="s_r_desc" name="descartar"><bpmn:incoming>Flujo_Pool_Servidor_27</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_29</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="s_r_cerrar" name="cerrar"><bpmn:incoming>Flujo_Pool_Servidor_28</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_30</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent><bpmn:sendTask id="s_dep" name="Depositar en el pozo, pasar turno y persistir"><bpmn:incoming>Flujo_Pool_Servidor_29</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_31</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="s_cierre" name="Evaluar el cierre, liquidar y persistir"><bpmn:incoming>Flujo_Pool_Servidor_30</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_32</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="s_dif1" name="Difundir estado: turno siguiente"><bpmn:incoming>Flujo_Pool_Servidor_31</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_33</bpmn:outgoing></bpmn:sendTask><bpmn:sendTask id="s_dif2" name="Difundir la liquidación"><bpmn:incoming>Flujo_Pool_Servidor_32</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Servidor_34</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="s_fin1" name="Turno cerrado"><bpmn:incoming>Flujo_Pool_Servidor_33</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="s_fin2" name="Ronda liquidada"><bpmn:incoming>Flujo_Pool_Servidor_34</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_Servidor_15" sourceRef="s_ini" targetRef="s_crear"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_16" sourceRef="s_crear" targetRef="s_guardar1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_17" sourceRef="s_guardar1" targetRef="s_sesion"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_18" sourceRef="s_sesion" targetRef="s_espera1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_19" sourceRef="s_espera1" targetRef="s_repartir"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_20" sourceRef="s_repartir" targetRef="s_guardar2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_21" sourceRef="s_guardar2" targetRef="s_difundir"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_22" sourceRef="s_difundir" targetRef="s_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_23" sourceRef="s_turno" targetRef="s_esp_robar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_24" sourceRef="s_esp_robar" targetRef="s_robar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_25" sourceRef="s_robar" targetRef="s_robo"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_26" sourceRef="s_robo" targetRef="s_ev"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_27" sourceRef="s_ev" targetRef="s_r_desc" name="descarta"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_28" sourceRef="s_ev" targetRef="s_r_cerrar" name="cierra"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_29" sourceRef="s_r_desc" targetRef="s_dep"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_30" sourceRef="s_r_cerrar" targetRef="s_cierre"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_31" sourceRef="s_dep" targetRef="s_dif1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_32" sourceRef="s_cierre" targetRef="s_dif2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_33" sourceRef="s_dif1" targetRef="s_fin1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Servidor_34" sourceRef="s_dif2" targetRef="s_fin2"></bpmn:sequenceFlow></bpmn:process>
<bpmn:process id="Proceso_Pool_Base" name="Supabase (IAlmacen)" isExecutable="false"><bpmn:startEvent id="d_ini" name="guardar sala"><bpmn:outgoing>Flujo_Pool_Base_35</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent><bpmn:serviceTask id="d_t1" name="Crear la sala (versión 1)"><bpmn:documentation>SupabaseStateRepository.crearSala: fila sala con datos JSONB; código único.</bpmn:documentation><bpmn:incoming>Flujo_Pool_Base_35</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Base_36</bpmn:outgoing></bpmn:serviceTask><bpmn:receiveTask id="d_r2" name="Recibir el estado inicial" instantiate="false"><bpmn:incoming>Flujo_Pool_Base_36</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Base_37</bpmn:outgoing></bpmn:receiveTask><bpmn:serviceTask id="d_t2" name="Guardar el snapshot de la partida"><bpmn:documentation>sala.datos (JSONB) con el snapshot; solo si la versión leída sigue vigente.</bpmn:documentation><bpmn:incoming>Flujo_Pool_Base_37</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Base_38</bpmn:outgoing></bpmn:serviceTask><bpmn:receiveTask id="d_r3" name="Recibir jugada o liquidación" instantiate="false"><bpmn:incoming>Flujo_Pool_Base_38</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Base_39</bpmn:outgoing></bpmn:receiveTask><bpmn:serviceTask id="d_t3" name="Guardar estado y llenar buzones"><bpmn:documentation>guardarAtomico: sala con versión optimista, mensajes en el buzón de cada jugador y eventos en una sola transacción (si otra petición ganó, se repite).</bpmn:documentation><bpmn:incoming>Flujo_Pool_Base_39</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Base_40</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="d_fin" name="Estado durable"><bpmn:incoming>Flujo_Pool_Base_40</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_Base_35" sourceRef="d_ini" targetRef="d_t1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Base_36" sourceRef="d_t1" targetRef="d_r2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Base_37" sourceRef="d_r2" targetRef="d_t2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Base_38" sourceRef="d_t2" targetRef="d_r3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Base_39" sourceRef="d_r3" targetRef="d_t3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Base_40" sourceRef="d_t3" targetRef="d_fin"></bpmn:sequenceFlow></bpmn:process>
