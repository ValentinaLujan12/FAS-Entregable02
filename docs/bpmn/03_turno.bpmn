<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Turno" name="03 - Ciclo de un turno (temporizador, robo, descarte y cierre)" targetNamespace="http://apuntado.unal.edu.co/bpmn" exporter="el-apuntado generador" exporterVersion="1.0">
<bpmn:collaboration id="Colaboracion_Turno"><bpmn:participant id="Pool_Turno" name="Turno de un jugador (PartidaEnCurso - TurnOrchestrator)" processRef="Proceso_Pool_Turno" /></bpmn:collaboration>
<bpmn:process id="Proceso_Pool_Turno" name="Turno de un jugador (PartidaEnCurso - TurnOrchestrator)" isExecutable="false"><bpmn:laneSet id="LaneSet_Pool_Turno"><bpmn:lane id="L_j" name="Jugador (cliente web)"><bpmn:flowNodeRef>t_robar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_lim1</bpmn:flowNodeRef><bpmn:flowNodeRef>t_decidir</bpmn:flowNodeRef><bpmn:flowNodeRef>t_lim2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_o" name="TurnOrchestrator"><bpmn:flowNodeRef>t_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>t_ini</bpmn:flowNodeRef><bpmn:flowNodeRef>t_g_inicial</bpmn:flowNodeRef><bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef><bpmn:flowNodeRef>t_m_fase2</bpmn:flowNodeRef><bpmn:flowNodeRef>t_g_accion</bpmn:flowNodeRef><bpmn:flowNodeRef>t_solicitar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fin_cierre</bpmn:flowNodeRef><bpmn:flowNodeRef>t_rechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>t_pasar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fin_ok</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_m" name="DeckManagement + IReglaJuego"><bpmn:flowNodeRef>t_g_origen</bpmn:flowNodeRef><bpmn:flowNodeRef>t_robar_mazo</bpmn:flowNodeRef><bpmn:flowNodeRef>t_g_hay</bpmn:flowNodeRef><bpmn:flowNodeRef>t_robar_pozo</bpmn:flowNodeRef><bpmn:flowNodeRef>t_tablas</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fin_tablas</bpmn:flowNodeRef><bpmn:flowNodeRef>t_m_robo</bpmn:flowNodeRef><bpmn:flowNodeRef>t_validar</bpmn:flowNodeRef><bpmn:flowNodeRef>t_g_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>t_depositar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_t" name="Programador de tiempo + autopiloto"><bpmn:flowNodeRef>t_m_auto</bpmn:flowNodeRef><bpmn:flowNodeRef>t_auto</bpmn:flowNodeRef><bpmn:flowNodeRef>t_pasar_auto</bpmn:flowNodeRef><bpmn:flowNodeRef>t_fin_auto</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="t_inicio" name="Turno asignado"><bpmn:outgoing>Flujo_Pool_Turno_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="t_ini" name="Fijar la fase y el cronómetro; difundir el estado"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF08, RF18
Implementación: PartidaEnCurso.turnoIniciado (tiempoTurnoMs; 8 s si el jugador está desconectado)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_1</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="t_g_inicial" name="¿Jugador inicial (11 cartas)?"><bpmn:incoming>Flujo_Pool_Turno_2</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_3</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Turno_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="t_robar" name="Elegir el robo: mazo o pozo"><bpmn:documentation>Componente: Cliente web
Requisitos: RF05
Implementación: POST /api/juego {t: &quot;robar&quot;}</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_3</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_5</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="t_lim1" name="Tiempo agotado" attachedToRef="t_robar" cancelActivity="true"><bpmn:documentation>Requisitos: RF08</bpmn:documentation><bpmn:outgoing>Flujo_Pool_Turno_26</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="t_g_origen" name="¿Origen del robo?"><bpmn:incoming>Flujo_Pool_Turno_5</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_6</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Turno_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_robar_mazo" name="Robar del mazo (reciclar el pozo si se agotó)"><bpmn:documentation>Componente: DeckManagement
Requisitos: RF05
Implementación: DeckManagement.robarDelMazo (maxReciclajes)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_6</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_8</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="t_g_hay" name="¿Quedan cartas?"><bpmn:incoming>Flujo_Pool_Turno_8</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_9</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Turno_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_robar_pozo" name="Tomar la carta visible del pozo"><bpmn:documentation>Componente: DeckManagement
Requisitos: RF05
Implementación: DeckManagement.robarDelPozo (si permitirRoboPozo)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_7</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_12</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_tablas" name="Declarar tablas: se agotó el mazo"><bpmn:documentation>Componente: TurnOrchestrator
Implementación: PartidaEnCurso.declararTablas</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_10</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_11</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="t_fin_tablas" name="Ronda en tablas (-&gt; 04)"><bpmn:incoming>Flujo_Pool_Turno_11</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="t_m_robo"><bpmn:incoming>Flujo_Pool_Turno_9</bpmn:incoming><bpmn:incoming>Flujo_Pool_Turno_12</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_reg" name="Registrar el robo y difundir (la carta es privada)"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF05, RF18
Implementación: evento CARTA_ROBADA (clave _privado solo para auditoría)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_13</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_14</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="t_m_fase2"><bpmn:incoming>Flujo_Pool_Turno_4</bpmn:incoming><bpmn:incoming>Flujo_Pool_Turno_14</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="t_decidir" name="Organizar la mano y elegir: descartar o cerrar"><bpmn:documentation>Componente: Cliente web
Requisitos: RF06, RF07
Implementación: arrastrar/agrupar (validar) - &quot;descartar&quot; - &quot;cerrar&quot;</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_15</bpmn:incoming><bpmn:incoming>Flujo_Pool_Turno_23</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_16</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="t_lim2" name="Tiempo agotado" attachedToRef="t_decidir" cancelActivity="true"><bpmn:documentation>Requisitos: RF08</bpmn:documentation><bpmn:outgoing>Flujo_Pool_Turno_27</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:exclusiveGateway id="t_g_accion" name="¿Acción elegida?"><bpmn:incoming>Flujo_Pool_Turno_16</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_17</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Turno_19</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_solicitar" name="Solicitar la evaluación del cierre"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF09, RF10
Implementación: PartidaEnCurso.cerrar</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_17</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_18</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="t_fin_cierre" name="Cierre solicitado (-&gt; 04)"><bpmn:incoming>Flujo_Pool_Turno_18</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="t_validar" name="Validar la carta: está en la mano y no es la robada del pozo"><bpmn:documentation>Componente: DeckManagement
Requisitos: RF07
Implementación: PartidaEnCurso.descartar (CARTA_NO_ENCONTRADA, DEVOLUCION_PROHIBIDA)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_19</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_20</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="t_g_ok" name="¿Descarte válido?"><bpmn:incoming>Flujo_Pool_Turno_20</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_21</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Turno_22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_depositar" name="Depositar la carta en el pozo y difundir"><bpmn:documentation>Componente: DeckManagement
Requisitos: RF07, RF18
Implementación: DeckManagement.descartar - evento CARTA_DESCARTADA</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_21</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_24</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_rechazo" name="Rechazar la acción y avisar al jugador"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF11
Implementación: ResultadoAccion {ok:false, codigo, mensaje}</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_22</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_23</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_pasar" name="Pasar el turno al siguiente jugador activo"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF07
Implementación: PartidaEnCurso.pasarTurno (salta eliminados)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_24</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_25</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="t_fin_ok" name="Turno completado (-&gt; 02)"><bpmn:incoming>Flujo_Pool_Turno_25</bpmn:incoming></bpmn:endEvent><bpmn:exclusiveGateway id="t_m_auto"><bpmn:incoming>Flujo_Pool_Turno_26</bpmn:incoming><bpmn:incoming>Flujo_Pool_Turno_27</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_28</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="t_auto" name="Jugada automática: robar si falta y descartar la carta de mayor costo"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF08
Implementación: PartidaEnCurso.expirarTurno - AnalisisMano.elegirDescarte</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_28</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_29</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="t_pasar_auto" name="Contar el timeout y pasar el turno (2 seguidos = autopiloto)"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF08
Implementación: timeouts consecutivos ≥ 2 -&gt; autopiloto (bot toma el control)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Turno_29</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Turno_30</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="t_fin_auto" name="Turno completado por tiempo (-&gt; 02)"><bpmn:incoming>Flujo_Pool_Turno_30</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_Turno_1" sourceRef="t_inicio" targetRef="t_ini"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_2" sourceRef="t_ini" targetRef="t_g_inicial"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_3" sourceRef="t_g_inicial" targetRef="t_robar" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_4" sourceRef="t_g_inicial" targetRef="t_m_fase2" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_5" sourceRef="t_robar" targetRef="t_g_origen"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_6" sourceRef="t_g_origen" targetRef="t_robar_mazo" name="Mazo"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_7" sourceRef="t_g_origen" targetRef="t_robar_pozo" name="Pozo"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_8" sourceRef="t_robar_mazo" targetRef="t_g_hay"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_9" sourceRef="t_g_hay" targetRef="t_m_robo" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_10" sourceRef="t_g_hay" targetRef="t_tablas" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_11" sourceRef="t_tablas" targetRef="t_fin_tablas"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_12" sourceRef="t_robar_pozo" targetRef="t_m_robo"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_13" sourceRef="t_m_robo" targetRef="t_reg"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_14" sourceRef="t_reg" targetRef="t_m_fase2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_15" sourceRef="t_m_fase2" targetRef="t_decidir"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_16" sourceRef="t_decidir" targetRef="t_g_accion"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_17" sourceRef="t_g_accion" targetRef="t_solicitar" name="Cerrar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_18" sourceRef="t_solicitar" targetRef="t_fin_cierre"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_19" sourceRef="t_g_accion" targetRef="t_validar" name="Descartar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_20" sourceRef="t_validar" targetRef="t_g_ok"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_21" sourceRef="t_g_ok" targetRef="t_depositar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_22" sourceRef="t_g_ok" targetRef="t_rechazo" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_23" sourceRef="t_rechazo" targetRef="t_decidir" name="Reintentar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_24" sourceRef="t_depositar" targetRef="t_pasar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_25" sourceRef="t_pasar" targetRef="t_fin_ok"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_26" sourceRef="t_lim1" targetRef="t_m_auto"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_27" sourceRef="t_lim2" targetRef="t_m_auto"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_28" sourceRef="t_m_auto" targetRef="t_auto"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_29" sourceRef="t_auto" targetRef="t_pasar_auto"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Turno_30" sourceRef="t_pasar_auto" targetRef="t_fin_auto"></bpmn:sequenceFlow><bpmn:textAnnotation id="n_desconexion"><bpmn:text>Si el jugador está desconectado, su turno se acorta (8 s por defecto) para no bloquear la mesa.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_desconexion" sourceRef="n_desconexion" targetRef="t_ini" /></bpmn:process>
