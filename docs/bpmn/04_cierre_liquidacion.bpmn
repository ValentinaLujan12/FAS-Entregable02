<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Cierre" name="04 - Cierre de ronda, liquidación por modalidad y fin de partida" targetNamespace="http://apuntado.unal.edu.co/bpmn" exporter="el-apuntado generador" exporterVersion="1.0">
<bpmn:collaboration id="Colaboracion_Cierre"><bpmn:participant id="Pool_Cierre" name="Cierre y liquidación (Strategy IReglaJuego)" processRef="Proceso_Pool_Cierre" /></bpmn:collaboration>
<bpmn:process id="Proceso_Pool_Cierre" name="Cierre y liquidación (Strategy IReglaJuego)" isExecutable="false"><bpmn:laneSet id="LaneSet_Pool_Cierre"><bpmn:lane id="L_o" name="TurnOrchestrator"><bpmn:flowNodeRef>c_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>c_pausar</bpmn:flowNodeRef><bpmn:flowNodeRef>c_rechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>c_fin_rech</bpmn:flowNodeRef><bpmn:flowNodeRef>c_ini_tablas</bpmn:flowNodeRef><bpmn:flowNodeRef>c_tablas</bpmn:flowNodeRef><bpmn:flowNodeRef>c_pausa</bpmn:flowNodeRef><bpmn:flowNodeRef>c_nueva</bpmn:flowNodeRef><bpmn:flowNodeRef>c_fin_ronda</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_m" name="HandEvaluator (IReglaJuego)"><bpmn:flowNodeRef>c_g_mod</bpmn:flowNodeRef><bpmn:flowNodeRef>c_v_clasica</bpmn:flowNodeRef><bpmn:flowNodeRef>c_v_apuntado</bpmn:flowNodeRef><bpmn:flowNodeRef>c_m_val</bpmn:flowNodeRef><bpmn:flowNodeRef>c_g_valido</bpmn:flowNodeRef><bpmn:flowNodeRef>c_evaluar_fin</bpmn:flowNodeRef><bpmn:flowNodeRef>c_g_fin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_p" name="RoundScoring"><bpmn:flowNodeRef>c_revelar</bpmn:flowNodeRef><bpmn:flowNodeRef>c_g_mod2</bpmn:flowNodeRef><bpmn:flowNodeRef>c_l_clasica</bpmn:flowNodeRef><bpmn:flowNodeRef>c_l_apuntado</bpmn:flowNodeRef><bpmn:flowNodeRef>c_m_liq</bpmn:flowNodeRef><bpmn:flowNodeRef>c_declarar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_d" name="StateRepository + notificación"><bpmn:flowNodeRef>c_m_guardar</bpmn:flowNodeRef><bpmn:flowNodeRef>c_guardar</bpmn:flowNodeRef><bpmn:flowNodeRef>c_difundir</bpmn:flowNodeRef><bpmn:flowNodeRef>c_notificar</bpmn:flowNodeRef><bpmn:flowNodeRef>c_fin</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="c_inicio" name="El jugador pulsa &quot;Cerrar ronda&quot;"><bpmn:outgoing>Flujo_Pool_Cierre_1</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="c_pausar" name="Pausar la mesa: bloquear acciones y temporizador"><bpmn:documentation>Componente: TurnOrchestrator
Implementación: PartidaEnCurso.cerrar (valida turno y fase DESCARTAR)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_1</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_2</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="c_g_mod" name="¿Modalidad?"><bpmn:documentation>Componente: RegistroReglas
Implementación: RegistroReglas.obtener(modalidad) - registro Open/Closed</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_2</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_3</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Cierre_4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:businessRuleTask id="c_v_clasica" name="Validar 1 cuarta + 2 ternas + 1 carta de descarte"><bpmn:documentation>Componente: ReglaClasicaCuartaTerna
Requisitos: RF09
Implementación: validarVictoria -&gt; buscarParticionExacta([4x1, 3x2])</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_3</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_5</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="c_v_apuntado" name="Validar 3 ternas y sobrante menor que el umbral (5)"><bpmn:documentation>Componente: ReglaApuntado101Puntos
Requisitos: RF10
Implementación: validarVictoria -&gt; buscarParticionExacta([3x3]) y sobrante &lt; 5</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_4</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_6</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="c_m_val"><bpmn:incoming>Flujo_Pool_Cierre_5</bpmn:incoming><bpmn:incoming>Flujo_Pool_Cierre_6</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_7</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="c_g_valido" name="¿Cierre válido?"><bpmn:documentation>Requisitos: RF11</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_7</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_8</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Cierre_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="c_rechazo" name="Notificar el rechazo y reanudar el turno"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF11
Implementación: evento CIERRE_RECHAZADO {motivo, detalle}</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_8</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_9</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="c_fin_rech" name="Turno reanudado (-&gt; 03)"><bpmn:incoming>Flujo_Pool_Cierre_9</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="c_revelar" name="Revelar las manos de todos los jugadores"><bpmn:documentation>Componente: RoundScoring
Requisitos: RF13, RF18
Implementación: LiquidacionVista (sobrantes y combinaciones por jugador)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_10</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_11</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="c_g_mod2" name="¿Modalidad?"><bpmn:incoming>Flujo_Pool_Cierre_11</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_12</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Cierre_13</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="c_l_clasica" name="El ganador suma una victoria de ronda"><bpmn:documentation>Componente: ReglaClasicaCuartaTerna
Requisitos: RF13
Implementación: liquidarRonda -&gt; victorias[ganador]++</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_12</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_14</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="c_l_apuntado" name="Los perdedores suman los puntos de sus cartas sueltas (As configurable)"><bpmn:documentation>Componente: ReglaApuntado101Puntos
Requisitos: RF13
Implementación: liquidarRonda -&gt; valoracion.puntosCarta (valorAs)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_13</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_15</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="c_m_liq"><bpmn:incoming>Flujo_Pool_Cierre_14</bpmn:incoming><bpmn:incoming>Flujo_Pool_Cierre_15</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:startEvent id="c_ini_tablas" name="Mazo agotado tras los reciclajes permitidos"><bpmn:outgoing>Flujo_Pool_Cierre_17</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="c_tablas" name="Declarar tablas: la ronda no suma puntos"><bpmn:documentation>Componente: TurnOrchestrator
Implementación: PartidaEnCurso.declararTablas</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_17</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_18</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="c_m_guardar"><bpmn:incoming>Flujo_Pool_Cierre_16</bpmn:incoming><bpmn:incoming>Flujo_Pool_Cierre_18</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_19</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="c_guardar" name="Guardar liquidación, marcador y manos iniciales (versión optimista)"><bpmn:documentation>Componente: StateRepository
Requisitos: RF14, RF19
Implementación: IAlmacen.guardarAtomico -&gt; guardar_sala_atomica / memoria</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_19</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_20</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="c_difundir" name="Difundir el resultado a todos (buzones + aviso Realtime)"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF18
Implementación: difundirEstado - vistaMesa por jugador en su buzón</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_20</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_21</bpmn:outgoing></bpmn:serviceTask><bpmn:businessRuleTask id="c_evaluar_fin" name="Aplicar eliminaciones por umbral y evaluar el fin de partida"><bpmn:documentation>Componente: HandEvaluator
Requisitos: RF15, RF16
Implementación: IReglaJuego.evaluarPartida</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_21</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_22</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="c_g_fin" name="¿Fin de partida?"><bpmn:incoming>Flujo_Pool_Cierre_22</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_23</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_Cierre_26</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="c_pausa" name="Pausa de liquidación: 60 s o voto &quot;Continuar&quot; de todos los humanos"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF17
Implementación: pausaLiquidacionSeg - PartidaEnCurso.votarContinuar / continuar</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_23</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_24</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="c_nueva" name="Preparar la nueva ronda: el ganador inicia con 11 cartas"><bpmn:documentation>Componente: DeckManagement
Requisitos: RF17
Implementación: PartidaEnCurso.iniciarRonda (siguienteIniciaId)</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_24</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_25</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="c_fin_ronda" name="Nueva ronda (-&gt; 02)"><bpmn:incoming>Flujo_Pool_Cierre_25</bpmn:incoming></bpmn:endEvent><bpmn:serviceTask id="c_declarar" name="Determinar posiciones y declarar al ganador"><bpmn:documentation>Componente: RoundScoring
Requisitos: RF16
Implementación: FinalVista.posiciones</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_26</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_27</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="c_notificar" name="Difundir el podio y habilitar la revancha"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF16, RF18
Implementación: evento PARTIDA_FINALIZADA - nueva_partida</bpmn:documentation><bpmn:incoming>Flujo_Pool_Cierre_27</bpmn:incoming><bpmn:outgoing>Flujo_Pool_Cierre_28</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="c_fin" name="Partida finalizada"><bpmn:incoming>Flujo_Pool_Cierre_28</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_Cierre_1" sourceRef="c_inicio" targetRef="c_pausar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_2" sourceRef="c_pausar" targetRef="c_g_mod"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_3" sourceRef="c_g_mod" targetRef="c_v_clasica" name="Clásica"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_4" sourceRef="c_g_mod" targetRef="c_v_apuntado" name="Apuntado"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_5" sourceRef="c_v_clasica" targetRef="c_m_val"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_6" sourceRef="c_v_apuntado" targetRef="c_m_val"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_7" sourceRef="c_m_val" targetRef="c_g_valido"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_8" sourceRef="c_g_valido" targetRef="c_rechazo" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_9" sourceRef="c_rechazo" targetRef="c_fin_rech"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_10" sourceRef="c_g_valido" targetRef="c_revelar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_11" sourceRef="c_revelar" targetRef="c_g_mod2"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_12" sourceRef="c_g_mod2" targetRef="c_l_clasica" name="Clásica"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_13" sourceRef="c_g_mod2" targetRef="c_l_apuntado" name="Apuntado"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_14" sourceRef="c_l_clasica" targetRef="c_m_liq"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_15" sourceRef="c_l_apuntado" targetRef="c_m_liq"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_16" sourceRef="c_m_liq" targetRef="c_m_guardar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_17" sourceRef="c_ini_tablas" targetRef="c_tablas"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_18" sourceRef="c_tablas" targetRef="c_m_guardar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_19" sourceRef="c_m_guardar" targetRef="c_guardar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_20" sourceRef="c_guardar" targetRef="c_difundir"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_21" sourceRef="c_difundir" targetRef="c_evaluar_fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_22" sourceRef="c_evaluar_fin" targetRef="c_g_fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_23" sourceRef="c_g_fin" targetRef="c_pausa" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_24" sourceRef="c_pausa" targetRef="c_nueva"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_25" sourceRef="c_nueva" targetRef="c_fin_ronda"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_26" sourceRef="c_g_fin" targetRef="c_declarar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_27" sourceRef="c_declarar" targetRef="c_notificar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_Cierre_28" sourceRef="c_notificar" targetRef="c_fin"></bpmn:sequenceFlow></bpmn:process>
