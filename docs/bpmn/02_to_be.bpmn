<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ToBe" name="02 - Proceso To-Be - Partida digital de extremo a extremo" targetNamespace="http://apuntado.unal.edu.co/bpmn" exporter="el-apuntado generador" exporterVersion="1.0">
<bpmn:collaboration id="Colaboracion_ToBe"><bpmn:participant id="Pool_ToBe" name="Sistema digital &quot;El Apuntado&quot; (Monolito Modular)" processRef="Proceso_Pool_ToBe" /></bpmn:collaboration>
<bpmn:process id="Proceso_Pool_ToBe" name="Sistema digital &quot;El Apuntado&quot; (Monolito Modular)" isExecutable="false"><bpmn:laneSet id="LaneSet_Pool_ToBe"><bpmn:lane id="L_jugador" name="Jugador / Anfitrión"><bpmn:flowNodeRef>b_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>b_crear</bpmn:flowNodeRef><bpmn:flowNodeRef>b_unirse</bpmn:flowNodeRef><bpmn:flowNodeRef>b_podio</bpmn:flowNodeRef><bpmn:flowNodeRef>b_g_rev</bpmn:flowNodeRef><bpmn:flowNodeRef>b_fin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_lobby" name="LobbyManager + DeckManagement"><bpmn:flowNodeRef>b_codigo</bpmn:flowNodeRef><bpmn:flowNodeRef>b_g_sala</bpmn:flowNodeRef><bpmn:flowNodeRef>b_repartir</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_orq" name="TurnOrchestrator"><bpmn:flowNodeRef>b_m_turno</bpmn:flowNodeRef><bpmn:flowNodeRef>b_ini_turno</bpmn:flowNodeRef><bpmn:flowNodeRef>b_ejecutar</bpmn:flowNodeRef><bpmn:flowNodeRef>b_t_limite</bpmn:flowNodeRef><bpmn:flowNodeRef>b_auto</bpmn:flowNodeRef><bpmn:flowNodeRef>b_g_cierre</bpmn:flowNodeRef><bpmn:flowNodeRef>b_m_pasar</bpmn:flowNodeRef><bpmn:flowNodeRef>b_pasar</bpmn:flowNodeRef><bpmn:flowNodeRef>b_rechazo</bpmn:flowNodeRef><bpmn:flowNodeRef>b_pausa</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_motor" name="HandEvaluator (IReglaJuego)"><bpmn:flowNodeRef>b_evaluar</bpmn:flowNodeRef><bpmn:flowNodeRef>b_g_valido</bpmn:flowNodeRef><bpmn:flowNodeRef>b_g_fin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_puntaje" name="RoundScoring + StateRepository"><bpmn:flowNodeRef>b_liquidar</bpmn:flowNodeRef><bpmn:flowNodeRef>b_guardar</bpmn:flowNodeRef><bpmn:flowNodeRef>b_declarar</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="b_inicio" name="El anfitrión quiere jugar"><bpmn:outgoing>Flujo_Pool_ToBe_1</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="b_crear" name="Crear sala y elegir modalidad y parámetros"><bpmn:documentation>Componente: LobbyManager
Requisitos: RF01
Implementación: TurnOrchestrator.crearSala - LobbyManager.crearSala</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_1</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_2</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="b_codigo" name="Generar el código único de la sala"><bpmn:documentation>Componente: LobbyManager
Requisitos: RF01, RF02
Implementación: LobbyManager (códigos de 5 caracteres sin ambigüedad)</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_2</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_3</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="b_unirse" name="Los jugadores se unen con el código (o se agregan bots)"><bpmn:documentation>Componente: LobbyManager
Requisitos: RF02
Implementación: unirse - agregarBot</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_3</bpmn:incoming><bpmn:incoming>Flujo_Pool_ToBe_6</bpmn:incoming><bpmn:incoming>Flujo_Pool_ToBe_28</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_4</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="b_g_sala" name="¿Sala válida (2-6) y lista?"><bpmn:documentation>Componente: LobbyManager
Requisitos: RF03</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_4</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_5</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_ToBe_6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="b_repartir" name="Barajar (1 o 2 mazos), repartir 10 cartas (+1 al inicial) y voltear el pozo"><bpmn:documentation>Componente: DeckManagement
Requisitos: RF04
Implementación: DeckManagement.repartir - Baraja.barajar (RNG inyectable)</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_5</bpmn:incoming><bpmn:incoming>Flujo_Pool_ToBe_25</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_7</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="b_m_turno"><bpmn:incoming>Flujo_Pool_ToBe_7</bpmn:incoming><bpmn:incoming>Flujo_Pool_ToBe_16</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="b_ini_turno" name="Iniciar turno: fase, cronómetro y difusión del estado"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF08, RF18
Implementación: PartidaEnCurso.turnoIniciado - Programador</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_8</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_9</bpmn:outgoing></bpmn:serviceTask><bpmn:callActivity id="b_ejecutar" name="Ejecutar el turno del jugador (ver 03 - Turno)" calledElement="Proceso_Pool_Turno"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF05, RF06, RF07
Implementación: PartidaEnCurso.robar/descartar</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_9</bpmn:incoming><bpmn:incoming>Flujo_Pool_ToBe_19</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_10</bpmn:outgoing></bpmn:callActivity><bpmn:boundaryEvent id="b_t_limite" name="Tiempo agotado" attachedToRef="b_ejecutar" cancelActivity="true"><bpmn:documentation>Requisitos: RF08</bpmn:documentation><bpmn:outgoing>Flujo_Pool_ToBe_11</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT60S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:serviceTask id="b_auto" name="Jugada automática: robar y descartar por el jugador"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF08
Implementación: PartidaEnCurso.expirarTurno - AnalisisMano.elegirDescarte (2 timeouts -&gt; autopiloto)</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_11</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_12</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="b_g_cierre" name="¿Solicitó el cierre?"><bpmn:incoming>Flujo_Pool_ToBe_10</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_13</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_ToBe_14</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="b_m_pasar"><bpmn:incoming>Flujo_Pool_ToBe_12</bpmn:incoming><bpmn:incoming>Flujo_Pool_ToBe_13</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_15</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="b_pasar" name="Pasar el turno al siguiente jugador activo"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF07
Implementación: PartidaEnCurso.pasarTurno</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_15</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_16</bpmn:outgoing></bpmn:serviceTask><bpmn:businessRuleTask id="b_evaluar" name="Evaluar el cierre según la modalidad"><bpmn:documentation>Componente: HandEvaluator
Requisitos: RF09, RF10, RF12
Implementación: IReglaJuego.validarVictoria (Strategy)</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_14</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_17</bpmn:outgoing></bpmn:businessRuleTask><bpmn:exclusiveGateway id="b_g_valido" name="¿Cierre válido?"><bpmn:documentation>Requisitos: RF11</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_17</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_18</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_ToBe_20</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="b_rechazo" name="Notificar el rechazo y reanudar el turno"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF11
Implementación: evento CIERRE_RECHAZADO</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_18</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_19</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="b_liquidar" name="Revelar manos y calcular la liquidación de la ronda"><bpmn:documentation>Componente: RoundScoring
Requisitos: RF13, RF17
Implementación: RoundScoring.liquidar (función pura)</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_20</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_21</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="b_guardar" name="Actualizar el marcador y guardar la sala (versión optimista)"><bpmn:documentation>Componente: StateRepository
Requisitos: RF14, RF19
Implementación: IAlmacen.guardarAtomico -&gt; guardar_sala_atomica (Supabase)</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_21</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_22</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="b_g_fin" name="¿Fin de partida?"><bpmn:documentation>Componente: HandEvaluator
Requisitos: RF15, RF16
Implementación: IReglaJuego.evaluarPartida</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_22</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_23</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_ToBe_24</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="b_pausa" name="Pausa de liquidación y nueva ronda"><bpmn:documentation>Componente: TurnOrchestrator
Requisitos: RF17
Implementación: PartidaEnCurso.continuar</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_24</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_25</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="b_declarar" name="Declarar al ganador y armar el podio"><bpmn:documentation>Componente: RoundScoring
Requisitos: RF16
Implementación: IReglaJuego.evaluarPartida -&gt; FinalVista</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_23</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_26</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="b_podio" name="Ver el podio; el anfitrión decide la revancha"><bpmn:documentation>Componente: Cliente web
Requisitos: RF18</bpmn:documentation><bpmn:incoming>Flujo_Pool_ToBe_26</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_27</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="b_g_rev" name="¿Revancha?"><bpmn:incoming>Flujo_Pool_ToBe_27</bpmn:incoming><bpmn:outgoing>Flujo_Pool_ToBe_28</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_ToBe_29</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="b_fin" name="Partida cerrada"><bpmn:incoming>Flujo_Pool_ToBe_29</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_ToBe_1" sourceRef="b_inicio" targetRef="b_crear"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_2" sourceRef="b_crear" targetRef="b_codigo"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_3" sourceRef="b_codigo" targetRef="b_unirse"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_4" sourceRef="b_unirse" targetRef="b_g_sala"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_5" sourceRef="b_g_sala" targetRef="b_repartir" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_6" sourceRef="b_g_sala" targetRef="b_unirse" name="No: esperar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_7" sourceRef="b_repartir" targetRef="b_m_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_8" sourceRef="b_m_turno" targetRef="b_ini_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_9" sourceRef="b_ini_turno" targetRef="b_ejecutar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_10" sourceRef="b_ejecutar" targetRef="b_g_cierre"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_11" sourceRef="b_t_limite" targetRef="b_auto"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_12" sourceRef="b_auto" targetRef="b_m_pasar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_13" sourceRef="b_g_cierre" targetRef="b_m_pasar" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_14" sourceRef="b_g_cierre" targetRef="b_evaluar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_15" sourceRef="b_m_pasar" targetRef="b_pasar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_16" sourceRef="b_pasar" targetRef="b_m_turno" name="Siguiente turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_17" sourceRef="b_evaluar" targetRef="b_g_valido"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_18" sourceRef="b_g_valido" targetRef="b_rechazo" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_19" sourceRef="b_rechazo" targetRef="b_ejecutar" name="Reanudar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_20" sourceRef="b_g_valido" targetRef="b_liquidar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_21" sourceRef="b_liquidar" targetRef="b_guardar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_22" sourceRef="b_guardar" targetRef="b_g_fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_23" sourceRef="b_g_fin" targetRef="b_declarar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_24" sourceRef="b_g_fin" targetRef="b_pausa" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_25" sourceRef="b_pausa" targetRef="b_repartir" name="Nueva ronda"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_26" sourceRef="b_declarar" targetRef="b_podio"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_27" sourceRef="b_podio" targetRef="b_g_rev"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_28" sourceRef="b_g_rev" targetRef="b_unirse" name="Sí: volver a la sala"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_ToBe_29" sourceRef="b_g_rev" targetRef="b_fin" name="No"></bpmn:sequenceFlow><bpmn:textAnnotation id="n_gap_calc"><bpmn:text>BRECHA CERRADA - cálculo manual de puntos -&gt; liquidación automática y determinista.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_gap_calc" sourceRef="n_gap_calc" targetRef="b_liquidar" /><bpmn:textAnnotation id="n_gap_traza"><bpmn:text>BRECHA CERRADA - sin trazabilidad -&gt; estado, manos e historial persistidos.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_gap_traza" sourceRef="n_gap_traza" targetRef="b_guardar" /></bpmn:process>
