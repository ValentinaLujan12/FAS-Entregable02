<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AsIs" name="01 - Proceso As-Is - Partida presencial de Apuntado" targetNamespace="http://apuntado.unal.edu.co/bpmn" exporter="el-apuntado generador" exporterVersion="1.0">
<bpmn:collaboration id="Colaboracion_AsIs"><bpmn:participant id="Pool_AsIs" name="Partida presencial de Apuntado (mesa física, 2 a 6 jugadores)" processRef="Proceso_Pool_AsIs" /></bpmn:collaboration>
<bpmn:process id="Proceso_Pool_AsIs" name="Partida presencial de Apuntado (mesa física, 2 a 6 jugadores)" isExecutable="false"><bpmn:laneSet id="LaneSet_Pool_AsIs"><bpmn:lane id="L_activo" name="Jugador activo"><bpmn:flowNodeRef>a_inicio</bpmn:flowNodeRef><bpmn:flowNodeRef>a_reglas</bpmn:flowNodeRef><bpmn:flowNodeRef>a_m_ronda</bpmn:flowNodeRef><bpmn:flowNodeRef>a_barajar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_m_turno</bpmn:flowNodeRef><bpmn:flowNodeRef>a_robar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_evaluar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_descartar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_g_cierre</bpmn:flowNodeRef><bpmn:flowNodeRef>a_cantar</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_demas" name="Demás jugadores"><bpmn:flowNodeRef>a_ceder</bpmn:flowNodeRef><bpmn:flowNodeRef>a_inspeccionar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_g_valida</bpmn:flowNodeRef><bpmn:flowNodeRef>a_disputa</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_anotador" name="Anotador (rol informal)"><bpmn:flowNodeRef>a_g_modo</bpmn:flowNodeRef><bpmn:flowNodeRef>a_contar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_sumar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_anotar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_m_fin</bpmn:flowNodeRef><bpmn:flowNodeRef>a_g_fin</bpmn:flowNodeRef><bpmn:flowNodeRef>a_eliminar</bpmn:flowNodeRef><bpmn:flowNodeRef>a_fin</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="a_inicio" name="El grupo decide jugar"><bpmn:outgoing>Flujo_Pool_AsIs_1</bpmn:outgoing></bpmn:startEvent><bpmn:manualTask id="a_reglas" name="Acordar las reglas de palabra (modalidad, valor del As, comodines)"><bpmn:documentation>Punto de dolor: reglas no estandarizadas.</bpmn:documentation><bpmn:incoming>Flujo_Pool_AsIs_1</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_2</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="a_m_ronda"><bpmn:incoming>Flujo_Pool_AsIs_2</bpmn:incoming><bpmn:incoming>Flujo_Pool_AsIs_23</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="a_barajar" name="Barajar y repartir 10 cartas (11 al jugador inicial)"><bpmn:documentation>Barajado manual y reparto presencial.</bpmn:documentation><bpmn:incoming>Flujo_Pool_AsIs_3</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_4</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="a_m_turno"><bpmn:incoming>Flujo_Pool_AsIs_4</bpmn:incoming><bpmn:incoming>Flujo_Pool_AsIs_11</bpmn:incoming><bpmn:incoming>Flujo_Pool_AsIs_15</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="a_robar" name="Robar una carta del mazo ciego o del pozo visible"><bpmn:incoming>Flujo_Pool_AsIs_5</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_6</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="a_evaluar" name="Evaluar la mano en privado y armar ternas o cuartas"><bpmn:incoming>Flujo_Pool_AsIs_6</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_7</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="a_descartar" name="Descartar una carta al pozo"><bpmn:incoming>Flujo_Pool_AsIs_7</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_8</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="a_g_cierre" name="¿Declara el cierre?"><bpmn:incoming>Flujo_Pool_AsIs_8</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_9</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_AsIs_10</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="a_cantar" name="Cantar victoria y extender las cartas sobre la mesa"><bpmn:incoming>Flujo_Pool_AsIs_10</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_12</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="a_ceder" name="El siguiente jugador toma el turno (aviso verbal)"><bpmn:incoming>Flujo_Pool_AsIs_9</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_11</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="a_inspeccionar" name="Inspeccionar la jugada a simple vista"><bpmn:incoming>Flujo_Pool_AsIs_12</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_13</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="a_g_valida" name="¿Jugada aceptada?"><bpmn:incoming>Flujo_Pool_AsIs_13</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_14</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_AsIs_16</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="a_disputa" name="Disputa y arbitraje informal"><bpmn:incoming>Flujo_Pool_AsIs_14</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_15</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="a_g_modo" name="¿Modalidad acordada?"><bpmn:incoming>Flujo_Pool_AsIs_16</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_17</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_AsIs_18</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="a_contar" name="Registrar de palabra la victoria de la ronda"><bpmn:incoming>Flujo_Pool_AsIs_17</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_20</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="a_sumar" name="Sumar a mano las cartas sueltas de los perdedores"><bpmn:incoming>Flujo_Pool_AsIs_18</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_19</bpmn:outgoing></bpmn:manualTask><bpmn:manualTask id="a_anotar" name="Anotar los puntajes negativos en una hoja de papel"><bpmn:incoming>Flujo_Pool_AsIs_19</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_21</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="a_m_fin"><bpmn:incoming>Flujo_Pool_AsIs_20</bpmn:incoming><bpmn:incoming>Flujo_Pool_AsIs_21</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_22</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="a_g_fin" name="¿Se cumple la condición de fin (meta acordada o ≥ 101)?"><bpmn:incoming>Flujo_Pool_AsIs_22</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_23</bpmn:outgoing><bpmn:outgoing>Flujo_Pool_AsIs_24</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="a_eliminar" name="Eliminar a quienes llegan a 101 y declarar al último en pie"><bpmn:incoming>Flujo_Pool_AsIs_24</bpmn:incoming><bpmn:outgoing>Flujo_Pool_AsIs_25</bpmn:outgoing></bpmn:manualTask><bpmn:endEvent id="a_fin" name="Ganador definitivo"><bpmn:incoming>Flujo_Pool_AsIs_25</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flujo_Pool_AsIs_1" sourceRef="a_inicio" targetRef="a_reglas"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_2" sourceRef="a_reglas" targetRef="a_m_ronda"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_3" sourceRef="a_m_ronda" targetRef="a_barajar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_4" sourceRef="a_barajar" targetRef="a_m_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_5" sourceRef="a_m_turno" targetRef="a_robar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_6" sourceRef="a_robar" targetRef="a_evaluar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_7" sourceRef="a_evaluar" targetRef="a_descartar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_8" sourceRef="a_descartar" targetRef="a_g_cierre"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_9" sourceRef="a_g_cierre" targetRef="a_ceder" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_10" sourceRef="a_g_cierre" targetRef="a_cantar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_11" sourceRef="a_ceder" targetRef="a_m_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_12" sourceRef="a_cantar" targetRef="a_inspeccionar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_13" sourceRef="a_inspeccionar" targetRef="a_g_valida"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_14" sourceRef="a_g_valida" targetRef="a_disputa" name="No"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_15" sourceRef="a_disputa" targetRef="a_m_turno"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_16" sourceRef="a_g_valida" targetRef="a_g_modo" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_17" sourceRef="a_g_modo" targetRef="a_contar" name="Clásica 4-3-3"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_18" sourceRef="a_g_modo" targetRef="a_sumar" name="Apuntado"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_19" sourceRef="a_sumar" targetRef="a_anotar"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_20" sourceRef="a_contar" targetRef="a_m_fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_21" sourceRef="a_anotar" targetRef="a_m_fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_22" sourceRef="a_m_fin" targetRef="a_g_fin"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_23" sourceRef="a_g_fin" targetRef="a_m_ronda" name="No: nueva ronda"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_24" sourceRef="a_g_fin" targetRef="a_eliminar" name="Sí"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flujo_Pool_AsIs_25" sourceRef="a_eliminar" targetRef="a_fin"></bpmn:sequenceFlow><bpmn:textAnnotation id="n_dolor_reglas"><bpmn:text>DOLOR 1 - Reglas no estandarizadas: acuerdos verbales ambiguos (As, comodines, modalidad).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_dolor_reglas" sourceRef="n_dolor_reglas" targetRef="a_reglas" /><bpmn:textAnnotation id="n_dolor_turno"><bpmn:text>DOLOR 2 - Sin control de turno: no hay temporizador para robar, organizar ni descartar.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_dolor_turno" sourceRef="n_dolor_turno" targetRef="a_robar" /><bpmn:textAnnotation id="n_dolor_valid"><bpmn:text>DOLOR 3 - Validación visual e informal del cierre, sujeta a la subjetividad de los rivales.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_dolor_valid" sourceRef="n_dolor_valid" targetRef="a_cantar" /><bpmn:textAnnotation id="n_dolor_calc"><bpmn:text>DOLOR 4 - Liquidación: cálculo aritmético manual, propenso a errores de conteo.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_dolor_calc" sourceRef="n_dolor_calc" targetRef="a_anotar" /><bpmn:textAnnotation id="n_dolor_traza"><bpmn:text>DOLOR 5 - Sin repositorio central ni trazabilidad de la partida.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Asoc_n_dolor_traza" sourceRef="n_dolor_traza" targetRef="a_eliminar" /></bpmn:process>
