        <mxCell id="v169" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fillColor=#fffbe6;strokeColor=#b8a24d;" value="&lt;b&gt;Desacoplamiento (ADR-02):&lt;/b&gt; el orquestador solo conoce &lt;i&gt;IValidadorCierre&lt;/i&gt;; nunca &lt;i&gt;IReglaJuego&lt;/i&gt; ni las reglas concretas. Una modalidad nueva = una clase que implementa &lt;i&gt;IReglaJuego&lt;/i&gt;; MotorReglas, RegistroReglas, game, deck, player, scoring, persistence y kernel no cambian (la modalidad es un código abierto y sus parámetros —acumulativa, umbral— se persisten como datos)." vertex="1">
          <mxGeometry height="98" width="440" x="1120" y="742" as="geometry" />
        </mxCell>
        <mxCell id="v170" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fillColor=#fffbe6;strokeColor=#b8a24d;" value="&lt;b&gt;Gobernanza (ADR-01):&lt;/b&gt; dependencias en un solo sentido y sin ciclos. &lt;i&gt;rules&lt;/i&gt;, &lt;i&gt;deck&lt;/i&gt;, &lt;i&gt;player&lt;/i&gt; e &lt;i&gt;infra&lt;/i&gt; no dependen de otros módulos de negocio; infra llama a game solo por &lt;i&gt;IComandosJuego&lt;/i&gt; (inversión de dependencia). Verificado por fitness functions (ArchUnit / PyTestArch)." vertex="1">
          <mxGeometry height="88" width="440" x="1120" y="848" as="geometry" />
        </mxCell>
