<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Fitness function FF-10 (Entregable 2, Sección 5.3): umbral estricto para los evaluadores de combinaciones.
  Los métodos del módulo rules deben quedar por debajo de 5 (CC ≤ 4), el valor que Richards y Ford
  recomiendan para código cohesivo y bien factorizado (Cap. 6). El umbral general del sistema es CC ≤ 10.
  La usa la prueba ComplejidadCiclomaticaFitnessTest.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>
    <module name="TreeWalker">
        <module name="CyclomaticComplexity">
            <property name="max" value="4"/>
            <property name="switchBlockAsSingleDecisionPoint" value="false"/>
        </module>
    </module>
</module>
